generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String       @id @default(uuid())
  name          String
  description   String?
  sku           String       @unique
  // Fabric (silk, poli, PYOR) — predates the category feature.
  category      String?
  // Product category shown as chips in inventory: Safa Main / Barati safa /
  // Accessory. Kept separate from `category` so the fabric data survives.
  productType   String?
  rentPrice     Float        @default(0)
  salePrice     Float        @default(0)
  discount      Float        @default(0)
  totalQuantity Int          @default(0)
  isRentable    Boolean      @default(true)
  isSellable    Boolean      @default(true)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rentals       RentalItem[]
  sales         SaleItem[]
  /// Per-branch price overrides. rentPrice/salePrice above are the base rate
  /// used by any branch that has not set its own.
  storePrices   StorePrice[]
  storeStock    StoreStock[]
}

/// How many of one product one branch holds.
///
/// Stock sits on a shelf in a particular shop, so it belongs to that shop.
/// Barati safas are the exception — they travel out to weddings and are drawn
/// from one shop-wide pool — so they have no rows here and keep using
/// Product.totalQuantity.
model StoreStock {
  id        String   @id @default(uuid())
  storeId   String
  productId String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
}

/// One branch's own price for one product.
///
/// The same safa does not fetch the same rate in Partapur as it does in
/// Chitri, so each branch can set its own. Both fields are nullable and
/// independent: a branch may want its own sale price while renting at the
/// shop-wide rate, and null means "use the base price" rather than "free".
model StorePrice {
  id        String   @id @default(uuid())
  storeId   String
  productId String
  rentPrice Float?
  salePrice Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
}

model Rental {
  id               String            @id @default(uuid())
  orderNumber      String            @unique
  customerName     String
  customerPhone    String?
  customerAltPhone String?
  customerAddress  String?
  fatherName       String?
  weddingDate      String?
  safaSize         String?
  notes            String?
  startDate        DateTime
  endDate          DateTime
  status           String
  totalAmount      Float
  paidAmount       Float             @default(0)
  remainingAmount  Float             @default(0)
  storeId          String?
  tieSafa          Boolean           @default(false)
  safaShape        String?
  safaTyingCount   Int               @default(1)
  // JSON array of the tying styles chosen and how many safas each covers:
  // [{ "id": "...", "name": "Jodhpuri", "price": 50, "quantity": 10 }, ...]
  // safaShape and safaTyingCount stay populated (joined names / total count)
  // so existing invoices and order lists keep working.
  safaTyingStyles  String?
  safaTyingName    String?
  safaTyingAddress String?
  safaTyingTime    String?
  safaTyingDate    String?
  tieSafaCharge    Float             @default(0)
  discount         Float             @default(0)
  paymentMethod    String?           @default("CASH")
  pickupName       String?
  pickupPhone      String?
  pickupDate       String?
  damageCharge     Float             @default(0)
  // Set when staff confirm the order is packed and ready for handover.
  // readyBy holds the username so the report can show who marked it.
  readyAt          DateTime?
  readyBy          String?
  /// Who took the order, for the admin report. Stored as a name rather than a
  /// relation so history survives a user being renamed or removed.
  createdBy        String?
  // Tying jobs are allocated to a registered artist by an admin or owner.
  // artistRate is per safa — what they earn for each one tied — so the amount
  // owed on an order is artistRate * safaTyingCount.
  artistId         String?
  artistRate       Float             @default(0)
  artistPaid       Boolean           @default(false)
  artist           Artist?           @relation(fields: [artistId], references: [id])
  /// The real allocation, one row per artist. artistId above is kept in step
  /// with the first of these so older reads still find an artist on the order.
  tyingAssignments TyingAssignment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invoice          Invoice?
  items            RentalItem[]
  store            Store?            @relation(fields: [storeId], references: [id])
}

model RentalItem {
  id               String  @id @default(uuid())
  rentalId         String
  productId        String
  quantity         Int
  returnedQuantity Int     @default(0)
  pricePerDay      Float
  product          Product @relation(fields: [productId], references: [id])
  rental           Rental  @relation(fields: [rentalId], references: [id])
}

model Sale {
  id               String            @id @default(uuid())
  orderNumber      String            @unique
  customerName     String
  customerPhone    String?
  customerAltPhone String?
  customerAddress  String?
  fatherName       String?
  weddingDate      String?
  safaSize         String?
  notes            String?
  totalAmount      Float
  storeId          String?
  discount         Float             @default(0)
  // Safa tying can be bought outright too, not just with a rental, so these
  // mirror the equivalent fields on Rental.
  tieSafa          Boolean           @default(false)
  safaShape        String?
  safaTyingCount   Int               @default(1)
  safaTyingStyles  String?
  safaTyingName    String?
  safaTyingAddress String?
  safaTyingTime    String?
  safaTyingDate    String?
  tieSafaCharge    Float             @default(0)
  // Bulk buyers go through the same POS screen; the order is simply tagged to
  // a registered vendor. Sales previously had no part-payment tracking, which
  // bulk orders need.
  vendorId         String?
  paidAmount       Float             @default(0)
  remainingAmount  Float             @default(0)
  readyAt          DateTime?
  readyBy          String?
  // Who is coming to collect the goods and when. Mirrors the same three fields
  // on Rental so both order lists can show delivery the same way; on a sale the
  // buyer often sends somebody else, so the customer's own name is not enough.
  pickupName       String?
  pickupPhone      String?
  pickupDate       String?
  /// Who rang up the sale, for the admin report.
  createdBy        String?
  artistId         String?
  artistRate       Float             @default(0)
  artistPaid       Boolean           @default(false)
  artist           Artist?           @relation("SaleArtist", fields: [artistId], references: [id])
  tyingAssignments TyingAssignment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invoice          Invoice?
  items            SaleItem[]
  vendor           Vendor?           @relation(fields: [vendorId], references: [id])
  store            Store?            @relation(fields: [storeId], references: [id])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  rentalId      String?  @unique
  saleId        String?  @unique
  amount        Float
  status        String
  paymentMethod String?  @default("CASH")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sale          Sale?    @relation(fields: [saleId], references: [id])
  rental        Rental?  @relation(fields: [rentalId], references: [id])
}

model Store {
  id         String           @id @default(uuid())
  name       String
  location   String?
  /// This branch's logo, as a public asset path. Partapur trades under the
  /// old Joshi Safa House mark; the newer branches use Safa King. Null means
  /// the shop default, so a new branch works before anyone sets one.
  logo       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  rentals    Rental[]
  sales      Sale[]
  users      User[]
  cashBooks  CashBook[]
  prices     StorePrice[]
  safaPrices StoreSafaPrice[]
  stock      StoreStock[]
}

model User {
  id               String        @id @default(uuid())
  email            String?       @unique
  username         String?       @unique
  password         String
  name             String
  // ADMIN — full access including the admin panel.
  // SUPER — shop floor lead: cash book, artist allocation.
  // USER  — POS and bookings only.
  role             String        @default("USER")
  // Admin can grant an individual SUPER access to the vendor register.
  canManageVendors Boolean       @default(false)
  /// Preferred UI language, so the choice follows the person rather than the
  /// browser they happen to be sitting at.
  language         String        @default("en")
  storeId          String?
  store            Store?        @relation(fields: [storeId], references: [id])
  sessions         WorkSession[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model SafaPricing {
  id              String   @id @default("default")
  roundedPrice    Float    @default(50)
  jodhpuriPrice   Float    @default(50)
  baratiSafaPrice Float    @default(50)
  updatedAt       DateTime @updatedAt
}

/// One branch's own tying rate for one style.
///
/// Tying is priced by the area it is done in, the same as the safas
/// themselves. Null is not allowed here — a row exists only when the branch
/// has deliberately set a rate, and no row means the shop rate.
model StoreSafaPrice {
  id           String     @id @default(uuid())
  storeId      String
  safaOptionId String
  price        Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  safaOption   SafaOption @relation(fields: [safaOptionId], references: [id], onDelete: Cascade)

  @@unique([storeId, safaOptionId])
  @@index([storeId])
}

model SafaOption {
  id          String           @id @default(uuid())
  name        String
  /// The shop-wide rate. A branch that charges differently overrides it in
  /// StoreSafaPrice; everyone else follows this, including later changes.
  price       Float            @default(50)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  storePrices StoreSafaPrice[]
}

model Artist {
  id           String            @id @default(uuid())
  name         String
  /// Their usual rate per safa tied. Allocation pre-fills from this, and an
  /// admin can still override it on an individual order.
  ratePerPiece Float             @default(0)
  phone        String?
  address      String?
  notes        String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  rentals      Rental[]
  sales        Sale[]            @relation("SaleArtist")
  /// Cash payments actually made to this artist (ledger entries).
  payments     ArtistPayment[]
  /// Every share of an order this artist was given. Earnings are summed from
  /// here, not from Rental.artistRate — a big order is split between several.
  assignments  TyingAssignment[]
}

/// One artist's share of one order's tying.
///
/// A hundred safas is not one person's day, so the shop splits the job: forty
/// to one artist, sixty to another. Each share carries its own count and its
/// own rate, because artists are not paid the same, and its own paid flag, so
/// one can be settled while the other waits.
///
/// The shares on an order may add up to less than the order needs — that is a
/// job still being staffed, not an error — but never to more than it needs.
model TyingAssignment {
  id        String   @id @default(uuid())
  /// Exactly one of rentalId / saleId is set.
  rentalId  String?
  saleId    String?
  artistId  String
  /// How many safas of this order this artist ties.
  quantity  Int      @default(0)
  /// Per safa, for this artist on this order.
  rate      Float    @default(0)
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  rental    Rental?  @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  sale      Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([saleId])
  @@index([artistId])
}

/// A cash payment made to an artist — separate from marking individual orders
/// as paid. The ledger lets admin record partial payments, keep running
/// balances, and add notes (e.g. "advance", "UPI ref #123").
model ArtistPayment {
  id       String   @id @default(uuid())
  artistId String
  amount   Float
  note     String?
  paidAt   DateTime @default(now())
  paidBy   String?
  artist   Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

model Vendor {
  id        String          @id @default(uuid())
  name      String
  phone     String?
  address   String?
  gstNumber String?
  notes     String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sales     Sale[]
  /// Payments received from this vendor (ledger entries).
  payments  VendorPayment[]
}

/// Payments received from a vendor (bulk buyer) to clear running dues.
model VendorPayment {
  id       String   @id @default(uuid())
  vendorId String
  amount   Float
  note     String?
  paidAt   DateTime @default(now())
  paidBy   String?
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

/// One cash day per store. Opening balance is carried from the previous day's
/// closing, so the chain is continuous without anyone re-entering it.
model CashBook {
  id             String      @id @default(uuid())
  storeId        String
  /// The day itself, stored at midnight local time.
  date           DateTime
  openingBalance Float       @default(0)
  submitted      Boolean     @default(false)
  submittedAt    DateTime?
  submittedBy    String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  store          Store       @relation(fields: [storeId], references: [id])
  entries        CashEntry[]

  @@unique([storeId, date])
}

/// Money leaving the till: bank remittance, cash sent to the account office,
/// or a manual adjustment when the count does not tally.
model CashEntry {
  id         String   @id @default(uuid())
  cashBookId String
  /// BANK | OFFICE | ADJUSTMENT
  type       String
  amount     Float
  reference  String?
  notes      String?
  createdBy  String?
  createdAt  DateTime @default(now())
  cashBook   CashBook @relation(fields: [cashBookId], references: [id], onDelete: Cascade)
}

/// One login-to-logout stretch, used to report staff working hours.
/// A session with no loggedOutAt is someone still on shift.
model WorkSession {
  id           String    @id @default(uuid())
  userId       String
  /// Copied so the report still reads correctly if a user is renamed.
  username     String
  storeId      String?
  loggedInAt   DateTime  @default(now())
  loggedOutAt  DateTime?
  /// Last heartbeat from the open app. If it stops — the window was closed,
  /// the machine slept, the power went — the session is auto-closed at this
  /// time rather than being left open and reporting nothing.
  lastSeenAt   DateTime  @default(now())
  /// MANUAL — pressed sign out. CASHBOOK — closed the day's account.
  /// CLOSED — the app window was closed. AUTO — heartbeat stopped.
  logoutReason String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedInAt])
}
