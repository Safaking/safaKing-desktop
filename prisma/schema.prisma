generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String       @id @default(uuid())
  name          String
  description   String?
  sku           String       @unique
  category      String?
  rentPrice     Float        @default(0)
  salePrice     Float        @default(0)
  discount      Float        @default(0)
  totalQuantity Int          @default(0)
  isRentable    Boolean      @default(true)
  isSellable    Boolean      @default(true)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  rentals       RentalItem[]
  sales         SaleItem[]
}

model Rental {
  id              String       @id @default(uuid())
  orderNumber     String       @unique
  customerName    String
  customerPhone   String?
  customerAltPhone String?
  customerAddress String?
  fatherName      String?
  weddingDate     String?
  safaSize        String?
  notes           String?
  startDate       DateTime
  endDate         DateTime
  status          String
  totalAmount     Float
  paidAmount      Float        @default(0)
  remainingAmount Float        @default(0)
  storeId         String?
  tieSafa          Boolean      @default(false)
  safaShape        String?
  safaTyingName    String?
  safaTyingAddress String?
  safaTyingTime    String?
  safaTyingDate    String?
  tieSafaCharge    Float        @default(0)
  discount         Float        @default(0)
  pickupName       String?
  pickupPhone      String?
  pickupDate       String?
  damageCharge     Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  invoice         Invoice?
  items           RentalItem[]
  store           Store?       @relation(fields: [storeId], references: [id])
}

model RentalItem {
  id               String  @id @default(uuid())
  rentalId         String
  productId        String
  quantity         Int
  returnedQuantity Int     @default(0)
  pricePerDay      Float
  product          Product @relation(fields: [productId], references: [id])
  rental           Rental  @relation(fields: [rentalId], references: [id])
}

model Sale {
  id               String     @id @default(uuid())
  orderNumber      String     @unique
  customerName     String
  customerPhone    String?
  customerAltPhone String?
  customerAddress  String?
  fatherName       String?
  weddingDate      String?
  safaSize         String?
  notes            String?
  totalAmount      Float
  storeId          String?
  discount         Float      @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  invoice          Invoice?
  items            SaleItem[]
  store            Store?     @relation(fields: [storeId], references: [id])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  rentalId      String?  @unique
  saleId        String?  @unique
  amount        Float
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sale          Sale?    @relation(fields: [saleId], references: [id])
  rental        Rental?  @relation(fields: [rentalId], references: [id])
}

model Store {
  id        String   @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rentals   Rental[]
  sales     Sale[]
  users     User[]
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  username  String?  @unique
  password  String
  name      String
  role      String   @default("EMPLOYEE")
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SafaPricing {
  id              String   @id @default("default")
  roundedPrice    Float    @default(50)
  jodhpuriPrice   Float    @default(50)
  baratiSafaPrice Float    @default(50)
  updatedAt       DateTime @updatedAt
}

