{
  "name": "rental-app",
  "version": "0.1.0",
  "private": true,
  "description": "Joshi Safa House rental management desktop app",
  "author": "Joshi Safa House",
  "main": "electron/main.js",
  "scripts": {
    "dev": "PRISMA_CLIENT_ENGINE_TYPE=library concurrently \"npm run next-dev\" \"wait-on http://localhost:3000 && electron .\"",
    "web": "PRISMA_CLIENT_ENGINE_TYPE=library next dev",
    "next-dev": "PRISMA_CLIENT_ENGINE_TYPE=library next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "electron": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.10.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "5.10.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "build": {
    "appId": "com.joshisafahouse.app",
    "productName": "Joshi Safa House",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Joshi Safa House"
    }
  }
}
